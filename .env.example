# --- OpenAI ---
OPENAI_API_KEY=your-key-here

# --- Hosted Postgres (Dokploy) ---
# Paste the database's "Internal Connection URL" from
# Dokploy -> Databases -> <your-db> -> Connection.
# DATABASE_URL=postgres://user:password@metascholar-db:5432/metascholar

# --- Local Postgres ---
# Leave POSTGRES_HOST empty to use DATABASE_URL. Set it for local development.
POSTGRES_HOST=localhost
POSTGRES_DB=metascholar
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# --- App auth ---
APP_USERNAME=admin
APP_PASSWORD=password

# --- First-boot bootstrap (optional) ---
# true => on container start, wait for Postgres, fetch the corpus and build the
# index once. Leave false to run `make get_data && make init` manually instead.
AUTO_INIT=false

# --- Reverse-proxy sub-path (optional) ---
# Set to the same value as the Dokploy domain "Path" (e.g. /metascholar) when
# the app is not served from the domain root.
# ROOT_PATH=
